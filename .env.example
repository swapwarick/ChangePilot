# ChangePilot environment variables
# Copy this file to .env and fill in the required values.
# All values marked [REQUIRED] must be set before the app will start.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database  [REQUIRED]
# ---------------------------------------------------------------------------
# PostgreSQL (used in production and Docker Compose)
DATABASE_URL=postgresql+psycopg://changepilot:changepilot@postgres:5432/changepilot
# SQLite fallback is used automatically if PostgreSQL is unreachable (local dev only)

# ---------------------------------------------------------------------------
# Neo4j  [REQUIRED for graph features]
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changepilot-password

# ---------------------------------------------------------------------------
# Redis  [REQUIRED for background jobs]
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Auth  [REQUIRED — generate with: openssl rand -hex 32]
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=dev-insecure-secret-CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Registered user storage quota in bytes (default: 30 MB = 31457280)
STORAGE_QUOTA_BYTES=31457280
# Set to true in cloud deployments — disables local filesystem browser in UI
IS_CLOUD=false

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_IS_CLOUD=false
# Better Auth (Next.js auth adapter)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
